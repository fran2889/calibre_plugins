msgid "Select %s fill color"
msgstr "Izaberi %s boju popune"

#: dialogs.py:1080
msgid "Use the same fill color for all text"
msgstr "Koristi istu boju popune za sav tekst"

#: dialogs.py:1081
msgid ""
"When checked, the fill color is used for all text.\n"
"When unchecked, you can set different fill colors for each text type."
msgstr ""
"Kada je označeno, boja popune se koristi za sav tekst.\n"
"Kada nije označeno, možete postaviti različite boje popune za svaki tip teksta."

#: dialogs.py:1092
msgid "Left aligned"
msgstr "Levo poravnato"

#: dialogs.py:1094
msgid "Centered"
msgstr "Centrirano"

#: dialogs.py:1096
msgid "Right aligned"
msgstr "Desno poravnato"

#: dialogs.py:1207
msgid "Size:"
msgstr "Veličina:"

