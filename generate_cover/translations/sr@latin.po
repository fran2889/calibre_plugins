msgid "Cover width:"
msgstr "Širina korica:"

#: dialogs.py:1212
msgid "The width in pixels of the output .jpg file"
msgstr "Širina u pikselima izlazne .jpg datoteke"

#: dialogs.py:1218
msgid "Cover height:"
msgstr "Visina korica:"

#: dialogs.py:1219
msgid "The height in pixels of the output .jpg file"
msgstr "Visina u pikselima izlazne .jpg datoteke"

#: dialogs.py:1225
msgid "Stretch image to use as cover background"
msgstr "Razvuci sliku da se koristi kao pozadina korica"

#: dialogs.py:1226
msgid ""
"Check this to overlay text on the image background.\n"
"Uncheck this to place text around the image."
msgstr ""
"Označite ovo da biste preklopili tekst preko pozadine slike.\n"
"Odznačite ovo da biste postavili tekst oko slike."

#: dialogs.py:1230
msgid "Resize cover dimensions to match background image"
msgstr "Promeni dimenzije korica da odgovaraju pozadinskoj slici"

#: dialogs.py:1231
msgid ""
"Check this to automatically resize the cover based on\n"
"the dimensions of the currently chosen background image"
msgstr ""
"Označite ovo da biste automatski promenili veličinu korica na osnovu\n"
"dimenzija trenutno izabrane pozadinske slike"

#: dialogs.py:1235
msgid "Resize image to scale up if smaller than available area"
msgstr "Povećaj sliku ako je manja od dostupnog prostora"

#: dialogs.py:1236
msgid ""
"Check this to automatically resize the cover image to fit the\n"
"the maximum area available if it is too small"
msgstr ""
"Označite ovo da biste automatski promenili veličinu slike korica da stane u\n"
"maksimalni dostupni prostor ako je previše mala"

#: dialogs.py:1242
msgid "Margins:"
msgstr "Margine:"

#: dialogs.py:1247
msgid "Top margin:"
msgstr "Gornja margina:"

#: dialogs.py:1248
msgid ""
"The margin in pixels from the top of the cover\n"
"to the first content"
msgstr ""
"Margina u pikselima od vrha korica\n"
"do prvog sadržaja"

#: dialogs.py:1256
msgid "Bottom margin:"
msgstr "Donja margina:"

#: dialogs.py:1257
msgid ""
"The margin in pixels from the bottom of the cover\n"
"to the last content"
msgstr ""
"Margina u pikselima od dna korica\n"
"do poslednjeg sadržaja"

#: dialogs.py:1265
msgid "Left margin:"
msgstr "Leva margina:"

#: dialogs.py:1266
msgid ""
"The minimum margin in pixels from the left of the cover\n"
"to the text content"
msgstr ""
"Minimalna margina u pikselima od leve strane korica\n"
"do tekstualnog sadržaja"

#: dialogs.py:1274
msgid "Right margin:"
msgstr "Desna margina:"

#: dialogs.py:1275
msgid ""
"The minimum margin in pixels from the right of the cover\n"
"to the text content"
msgstr ""
"Minimalna margina u pikselima od desne strane korica\n"
"do tekstualnog sadržaja"

#: dialogs.py:1283
msgid "Text padding:"
msgstr "Razmak teksta:"

#: dialogs.py:1284
msgid "The spacing in pixels between successive lines of text"
msgstr "Razmak u pikselima između uzastopnih redova teksta"

#: dialogs.py:1291
msgid "Image padding:"
msgstr "Razmak slike:"

#: dialogs.py:1292
msgid ""
"The spacing in pixels between the image and text\n"
"placed above and below it"
msgstr ""
"Razmak u pikselima između slike i teksta\n"
"postavljenog iznad i ispod nje"

#: dialogs.py:1302
msgid "Border Widths:"
msgstr "Širine ivica:"

#: dialogs.py:1306
msgid "Cover border:"
msgstr "Ivica korica:"

#: dialogs.py:1307
msgid ""
"The width in pixels of a border around the edge\n"
"of the cover. Specify 0 for no border"
msgstr ""
"Širina u pikselima ivice oko ruba\n"
"korica. Unesite 0 za bez ivice"

#: dialogs.py:1314
msgid "Image border:"
msgstr "Ivica slike:"

#: dialogs.py:1315
msgid ""
"The width in pixels of a border around the edge\n"
"of the image. Specify 0 for no border"
msgstr ""
"Širina u pikselima ivice oko ruba\n"
"slike. Unesite 0 za bez ivice"

#: dialogs.py:1354
msgid "Field Order:"
msgstr "Redosled polja:"

#: dialogs.py:1355
msgid ""
"Alter the order of items on the cover and\n"
"whether they are displayed using the checkbox"
msgstr ""
"Promenite redosled stavki na koricama i\n"
"da li se prikazuju pomoću polja za potvrdu"

#: dialogs.py:1369
msgid "Move field up"
msgstr "Pomeri polje gore"

#: dialogs.py:1376
msgid "Move field down"
msgstr "Pomeri polje dole"

#: dialogs.py:1382
msgid "Other Options:"
msgstr "Ostale opcije:"

#: dialogs.py:1386
msgid "Custom text:"
msgstr "Prilagođeni tekst:"

#: dialogs.py:1396
msgid "Swap author LN,FN to FN LN"
msgstr "Zameni redosled autora iz LN, FN u FN LN"

#: dialogs.py:1397
msgid ""
"Use this option if your authors are stored as LN, FN\n"
"but you prefer to see FN LN on the book cover"
msgstr ""
"Koristite ovu opciju ako su vaši autori sačuvani kao Prezime, Ime\n"
"ali više volite da vidite Ime Prezime na koricama knjige"

#: dialogs.py:1401
msgid "Series text:"
msgstr "Tekst serije:"

#: dialogs.py:1402
msgid ""
"Change the way series information is displayed.\n"
"Useful for non-English languages!"
msgstr ""
"Promenite način na koji se prikazuju informacije o seriji.\n"
"Korisno za neengleske jezike!"

#: dialogs.py:1410
msgid "Metadata: (*not saved)"
msgstr "Metapodaci: (*nije sačuvano)"

#: dialogs.py:1411
msgid ""
"Optionally override the text in these fields for this book.\n"
"These are not saved as part of the settings profile.\n"
"This functionality is disabled if multiple books are selected."
msgstr ""
"Opciono zamenite tekst u ovim poljima za ovu knjigu.\n"
"Ovo se ne čuva kao deo profila podešavanja.\n"
"Ova funkcionalnost je onemogućena ako je izabrano više knjiga."

