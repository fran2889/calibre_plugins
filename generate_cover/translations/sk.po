msgstr "Uložené nastavenie s týmto názvom už existuje."

#: dialogs.py:647
msgid "Import Failed"
msgstr "Import zlyhal"

#: dialogs.py:648
msgid "This is not a valid Generate Cover export archive"
msgstr "Toto nie je platný exportný archív nástroja Vygenerovať obálku"

