msgid ""
"An image file already exists with this name. Do you want to overwrite it?"
msgstr "Obrázkový súbor s týmto názvom už existuje. Chcete ho prepísať?"

#: dialogs.py:896
msgid "Enter image name"
msgstr "Zadajte názov obrázka"

#: dialogs.py:897
msgid "Enter a unique name for this image:"
msgstr "Zadajte jedinečný názov pre tento obrázok:"

#: dialogs.py:911
msgid "You do not have permission to overwrite the file"
msgstr "Nemáte oprávnenie na prepísanie súboru"

#: dialogs.py:947 dialogs.py:958
msgid "Title"
msgstr "Názov"

#: dialogs.py:948 dialogs.py:959
msgid "Author"
msgstr "Autor"

#: dialogs.py:949 dialogs.py:960
msgid "Series"
msgstr "Séria"

#: dialogs.py:950 dialogs.py:961
msgid "Custom"
msgstr "Vlastné"

#: dialogs.py:953
msgid "Background"
msgstr "Pozadie"

#: dialogs.py:954
msgid "Border"
msgstr "Orámovanie"

#: dialogs.py:974
msgid "Fonts:"
msgstr "Písma:"

#: dialogs.py:983
msgid ""
"Select a font and specify a size in pixels.\n"
"If font set to 'Default', uses the tweak value from\n"
"'generate_cover_title_font' if present."
msgstr ""
"Vyberte písmo a zadajte veľkosť v pixeloch.\n"
"Ak je písmo nastavené na 'Predvolené', použije sa hodnota vylepšenia\n"
"'generate_cover_title_font', ak je prítomná."

#: dialogs.py:1002
msgid "Use the same font family for all text"
msgstr "Použiť rovnakú rodinu písiem pre všetok text"

#: dialogs.py:1003
msgid ""
"When checked, the same font family is used for all text content on the cover"
msgstr ""
"Ak je začiarknuté, pre všetok textový obsah na obálke sa použije rovnaká "
"rodina písiem"

#: dialogs.py:1010
msgid "Auto-reduce font size to fit on one line"
msgstr "Automaticky zmenšiť veľkosť písma, aby sa zmestilo na jeden riadok"

#: dialogs.py:1011
msgid ""
"When checked, the font size will be used as a maximum size.\n"
"A reduced size will be used where needed to fit text on one line."
msgstr ""
"Ak je začiarknuté, veľkosť písma sa použije ako maximálna veľkosť.\n"
"Tam, kde je to potrebné, sa použije zmenšená veľkosť, aby sa text zmestil na jeden riadok."

#: dialogs.py:1017
msgid "Colors:"
msgstr "Farby:"

#: dialogs.py:1035
msgid "Reset %s color"
msgstr "Obnoviť farbu %s"

#: dialogs.py:1041
msgid "Select a %s color"
msgstr "Vyberte farbu %s"

#: dialogs.py:1063
msgid "Reset %s fill color"
msgstr "Obnoviť farbu výplne %s"

#: dialogs.py:1069
msgid "Select %s fill color"
msgstr "Vyberte farbu výplne %s"

#: dialogs.py:1080
msgid "Use the same fill color for all text"
msgstr "Použiť rovnakú farbu výplne pre všetok text"

#: dialogs.py:1081
msgid ""
"When checked, the fill color is used for all text.\n"
"When unchecked, you can set different fill colors for each text type."
msgstr ""
"Ak je začiarknuté, farba výplne sa použije pre všetok text.\n"
"Ak je odčiarknuté, môžete nastaviť rôzne farby výplne pre každý typ textu."

#: dialogs.py:1092
msgid "Left aligned"
msgstr "Zarovnané vľavo"

#: dialogs.py:1094
msgid "Centered"
msgstr "Na stred"

#: dialogs.py:1096
msgid "Right aligned"
msgstr "Zarovnané vpravo"

#: dialogs.py:1207
msgid "Size:"
msgstr "Veľkosť:"

#: dialogs.py:1211
msgid "Cover width:"
msgstr "Šírka obálky:"

#: dialogs.py:1212
msgid "The width in pixels of the output .jpg file"
msgstr "Šírka výstupného súboru .jpg v pixeloch"

#: dialogs.py:1218
msgid "Cover height:"
msgstr "Výška obálky:"

#: dialogs.py:1219
msgid "The height in pixels of the output .jpg file"
msgstr "Výška výstupného súboru .jpg v pixeloch"

#: dialogs.py:1225
msgid "Stretch image to use as cover background"
msgstr "Roztiahnuť obrázok na použitie ako pozadie obálky"

#: dialogs.py:1226
msgid ""
"Check this to overlay text on the image background.\n"
"Uncheck this to place text around the image."
msgstr ""
"Začiarknutím prekryjete textom pozadie obrázka.\n"
"Odčiarknutím umiestnite text okolo obrázka."

#: dialogs.py:1230
msgid "Resize cover dimensions to match background image"
msgstr "Zmeniť rozmery obálky podľa pozadia obrázka"

#: dialogs.py:1231
msgid ""
"Check this to automatically resize the cover based on\n"
"the dimensions of the currently chosen background image"
msgstr ""
"Začiarknutím automaticky zmeníte veľkosť obálky podľa\n"
"rozmerov aktuálne zvoleného obrázka pozadia"

#: dialogs.py:1235
msgid "Resize image to scale up if smaller than available area"
msgstr "Zmeniť veľkosť obrázka, ak je menší ako dostupná oblasť"

#: dialogs.py:1236
msgid ""
"Check this to automatically resize the cover image to fit the\n"
"the maximum area available if it is too small"
msgstr ""
"Začiarknutím automaticky zmeníte veľkosť obrázka obálky, aby sa zmestil\n"
"do maximálnej dostupnej oblasti, ak je príliš malý"

#: dialogs.py:1242
msgid "Margins:"
msgstr "Okraje:"

#: dialogs.py:1247
msgid "Top margin:"
msgstr "Horný okraj:"

#: dialogs.py:1248
msgid ""
"The margin in pixels from the top of the cover\n"
"to the first content"
msgstr ""
"Okraj v pixeloch od hornej časti obálky\n"
"po prvý obsah"

#: dialogs.py:1256
msgid "Bottom margin:"
msgstr "Dolný okraj:"

#: dialogs.py:1257
msgid ""
"The margin in pixels from the bottom of the cover\n"
"to the last content"
msgstr ""
"Okraj v pixeloch od spodnej časti obálky\n"
"po posledný obsah"

#: dialogs.py:1265
msgid "Left margin:"
msgstr "Ľavý okraj:"

#: dialogs.py:1266
msgid ""
"The minimum margin in pixels from the left of the cover\n"
"to the text content"
msgstr ""
"Minimálny okraj v pixeloch od ľavej časti obálky\n"
"po textový obsah"

#: dialogs.py:1274
msgid "Right margin:"
msgstr "Pravý okraj:"

#: dialogs.py:1275
msgid ""
"The minimum margin in pixels from the right of the cover\n"
"to the text content"
msgstr ""
"Minimálny okraj v pixeloch od pravej časti obálky\n"
"po textový obsah"

#: dialogs.py:1283
msgid "Text padding:"
msgstr "Odsadenie textu:"

#: dialogs.py:1284
msgid "The spacing in pixels between successive lines of text"
msgstr "Rozstup v pixeloch medzi po sebe idúcimi riadkami textu"

#: dialogs.py:1291
msgid "Image padding:"
msgstr "Odsadenie obrázka:"

#: dialogs.py:1292
msgid ""
"The spacing in pixels between the image and text\n"
"placed above and below it"
msgstr ""
"Rozstup v pixeloch medzi obrázkom a textom\n"
"umiestneným nad a pod ním"

#: dialogs.py:1302
msgid "Border Widths:"
msgstr "Šírky orámovania:"

#: dialogs.py:1306
msgid "Cover border:"
msgstr "Orámovanie obálky:"

#: dialogs.py:1307
msgid ""
"The width in pixels of a border around the edge\n"
"of the cover. Specify 0 for no border"
msgstr ""
"Šírka orámovania okolo okraja obálky v pixeloch.\n"
"Zadajte 0 pre žiadne orámovanie"

#: dialogs.py:1314
msgid "Image border:"
msgstr "Orámovanie obrázka:"

#: dialogs.py:1315
msgid ""
"The width in pixels of a border around the edge\n"
"of the image. Specify 0 for no border"
msgstr ""
"Šírka orámovania okolo okraja obrázka v pixeloch.\n"
"Zadajte 0 pre žiadne orámovanie"

#: dialogs.py:1354
msgid "Field Order:"
msgstr "Poradie polí:"

#: dialogs.py:1355
msgid ""
"Alter the order of items on the cover and\n"
"whether they are displayed using the checkbox"
msgstr ""
"Zmeňte poradie položiek na obálke a to, či sa zobrazujú,\n"
"pomocou začiarkavacieho políčka"

#: dialogs.py:1369
msgid "Move field up"
msgstr "Presunúť pole nahor"

#: dialogs.py:1376
msgid "Move field down"
msgstr "Presunúť pole nadol"

#: dialogs.py:1382
msgid "Other Options:"
msgstr "Iné možnosti:"

#: dialogs.py:1386
msgid "Custom text:"
msgstr "Vlastný text:"

#: dialogs.py:1396
msgid "Swap author LN,FN to FN LN"
msgstr "Zameniť autora Priezvisko,Meno na Meno Priezvisko"

#: dialogs.py:1397
msgid ""
"Use this option if your authors are stored as LN, FN\n"
"but you prefer to see FN LN on the book cover"
msgstr ""
"Použite túto možnosť, ak sú vaši autori uložení ako Priezvisko, Meno,\n"
"ale na obálke knihy preferujete Meno Priezvisko"

#: dialogs.py:1401
msgid "Series text:"
msgstr "Text série:"

#: dialogs.py:1402
msgid ""
"Change the way series information is displayed.\n"
"Useful for non-English languages!"
msgstr ""
"Zmeňte spôsob zobrazovania informácií o sérii.\n"
"Užitočné pre neanglické jazyky!"

#: dialogs.py:1410
msgid "Metadata: (*not saved)"
msgstr "Metadáta: (*neuložené)"

#: dialogs.py:1411
msgid ""
"Optionally override the text in these fields for this book.\n"
"These are not saved as part of the settings profile.\n"
"This functionality is disabled if multiple books are selected."
msgstr ""
