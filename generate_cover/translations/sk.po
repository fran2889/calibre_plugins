msgstr "Máte neuložené zmeny v nastavení <b>%s</b>.<br>"

#: dialogs.py:132 dialogs.py:155
msgid "What do you want to do?"
msgstr "Čo chcete urobiť?"

#: dialogs.py:135
msgid "Discard Changes"
msgstr "Zahodiť zmeny"

#: dialogs.py:136
msgid "Revert unsaved changes"
msgstr "Vrátiť neuložené zmeny"

#: dialogs.py:138
msgid "Save Changes"
msgstr "Uložiť zmeny"

#: dialogs.py:139
msgid "Overwrite current profile with these changes"
msgstr "Prepísať aktuálny profil týmito zmenami"

#: dialogs.py:158
msgid "Generate && Save"
msgstr "Vygenerovať && uložiť"

#: dialogs.py:159
msgid "Generate cover using these settings and save for future usage"
msgstr ""
"Vygeneruje obálku pomocou týchto nastavení a uloží ich na budúce použitie"

#: dialogs.py:161
msgid "Generate && Revert"
msgstr "Vygenerovať && vrátiť"

#: dialogs.py:162
msgid "Generate cover using these settings then discard them"
msgstr "Vygeneruje obálku pomocou týchto nastavení a potom ich zahodí"

#: dialogs.py:166
msgid "Cancel action"
msgstr "Zrušiť akciu"

#: dialogs.py:450 dialogs.py:528
msgid "Saved Settings:"
